rules_version = '2'; 
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomPath(code) {
      return /databases/$(database)/documents/rooms/$(code);
    }

    function isMember(code) { 
      return signedIn()
        && exists(roomPath(code))
        && request.auth.uid in get(roomPath(code)).data.memberUids;
    }

    function isHost(code) {
      return signedIn()
        && exists(roomPath(code))
        && get(roomPath(code)).data.hostUid == request.auth.uid;
    }

    function hostLeaseExpired(code) {
      let data = get(roomPath(code)).data;
      return (
        'hostHeartbeatAt' in data
        && data.hostHeartbeatAt is timestamp
        && data.hostHeartbeatAt < request.time - duration.value(30, 's')
      ) || (
        !('hostHeartbeatAt' in data)
        && 'createdAt' in data
        && data.createdAt < request.time - duration.value(30, 's')
      );
    }

    function canClaimHost(code) {
      return signedIn()
        && request.auth.uid in resource.data.memberUids
        && hostLeaseExpired(code)
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostHeartbeatAt == request.time
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['hostUid', 'hostHeartbeatAt', 'updatedAt']);
    }

    function validAction(code, playerUid) {
      let roomData = get(roomPath(code)).data;
      let actorPath = /databases/$(database)/documents/rooms/$(code)/players/$(playerUid);
      let targetPath = /databases/$(database)/documents/rooms/$(code)/players/$(request.resource.data.targetUid);
      let actorPrivatePath = /databases/$(database)/documents/rooms/$(code)/private/$(playerUid);
      let targetPrivatePath = /databases/$(database)/documents/rooms/$(code)/private/$(request.resource.data.targetUid);

      return request.resource.data.keys().hasOnly([
          'uid', 'type', 'targetUid', 'phase', 'round', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'type', 'targetUid', 'phase', 'round', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != playerUid
        && request.resource.data.phase == roomData.phase
        && request.resource.data.round == roomData.round
        && request.resource.data.updatedAt == request.time
        && exists(actorPath)
        && get(actorPath).data.alive == true
        && (
          request.resource.data.type == 'abstain'
          || (
            exists(targetPath)
            && (
              get(targetPath).data.alive == true
              || (
                request.resource.data.phase == 'night'
                && request.resource.data.type == 'stealRole'
                && get(targetPath).data.alive == false
              )
            )
          )
        )
        && (
          (
            request.resource.data.phase == 'night'
            && exists(actorPrivatePath)
            && exists(targetPrivatePath)
            && (
              (
                request.resource.data.type == 'kill'
                && get(actorPrivatePath).data.role == 'Mafia'
                && get(targetPrivatePath).data.role != 'Mafia'
                && get(targetPrivatePath).data.role != 'Silencer'
              )
              || (
                request.resource.data.type == 'kill'
                && get(actorPrivatePath).data.role == 'Silencer'
                && get(targetPrivatePath).data.role != 'Mafia'
                && get(targetPrivatePath).data.role != 'Silencer'
              )
              || (
                request.resource.data.type == 'silence'
                && get(actorPrivatePath).data.role == 'Silencer'
                && get(targetPath).data.alive == true
              )
              || (
                request.resource.data.type == 'protect'
                && get(actorPrivatePath).data.role == 'Doctor'
              )
              || (
                request.resource.data.type == 'investigate'
                && get(actorPrivatePath).data.role == 'Detective'
              )
              || (
                request.resource.data.type == 'track'
                && get(actorPrivatePath).data.role == 'Tracker'
              )
              || (
                request.resource.data.type == 'steal'
                && get(actorPrivatePath).data.role == 'Thief'
                && get(actorPrivatePath).data.roleStolen == false
                && get(targetPath).data.alive == true
              )
              || (
                request.resource.data.type == 'stealRole'
                && get(actorPrivatePath).data.role == 'Thief'
                && get(actorPrivatePath).data.roleStolen == false
                && get(actorPrivatePath).data.thiefTokens >= 5
                && get(targetPath).data.alive == false
                && get(targetPrivatePath).data.role != 'Thief'
              )
            )
          )
          || (
            request.resource.data.phase == 'discussion'
            && request.resource.data.type == 'challenge'
            && exists(actorPrivatePath)
            && get(actorPrivatePath).data.role == 'Knight'
            && get(actorPrivatePath).data.knightChallengeUsed == false
            && get(targetPath).data.alive == true
          )
          || (
            request.resource.data.phase == 'voting'
            && (
              (
                request.resource.data.type == 'abstain'
                && request.resource.data.targetUid == '__abstain__'
              )
              || (
                request.resource.data.type == 'vote'
                && exists(targetPath)
                && get(targetPath).data.alive == true
                && (
                  roomData.voteStage != 'tiebreaker'
                  || request.resource.data.targetUid in roomData.tiedPlayerUids
                )
              )
            )
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'avatarData', 'activeTitle', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'avatarData', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 18
        && request.resource.data.avatarData is string
        && request.resource.data.avatarData.size() <= 150000
        && (!('activeTitle' in request.resource.data) || request.resource.data.activeTitle is string)
        && (!('activeTitle' in request.resource.data) || request.resource.data.activeTitle.size() <= 100)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'avatarData', 'gamesPlayed', 'wins', 'losses',
          'winRate', 'roleGames', 'roleWins', 'alignmentGames', 'alignmentWins',
          'mostPlayedRole', 'mostPlayedAlignment', 'currentWinStreak',
          'bestWinStreak', 'unlockedAchievements', 'activeTitle', 'updatedAt'
        ]);
      allow delete: if false;

      match /games/{gameId} {
        allow read, create: if signedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    match /rooms/{code} {
      allow get: if signedIn()
        && (
          resource == null
          || isMember(code)
          || resource.data.phase == 'lobby'
        );
      allow list: if isMember(code);

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.phase == 'lobby';

      allow update: if
        isHost(code)
        || canClaimHost(code)
        || (
          signedIn()
          && resource.data.phase == 'lobby'
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size()
            == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 12
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['memberUids', 'updatedAt'])
        )
        || (
          signedIn()
          && request.auth.uid in resource.data.memberUids
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size()
            == resource.data.memberUids.size() - 1
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['memberUids', 'hostUid', 'updatedAt'])
        );

      allow delete: if false;

      match /players/{playerUid} {
        allow read: if isMember(code);

        allow create: if isHost(code)
          || (
            signedIn()
            && request.auth.uid == playerUid
            && isMember(code)
          );

        allow update: if isHost(code)
          || (
            signedIn()
            && request.auth.uid == playerUid
            && isMember(code)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['ready', 'activeTitle', 'playAgain'])
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready'])
                && request.resource.data.ready is bool)
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeTitle'])
                && request.resource.data.activeTitle is string
                && request.resource.data.activeTitle.size() <= 100)
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playAgain'])
                && request.resource.data.playAgain is bool
                && get(roomPath(code)).data.phase == 'finished')
            )
          );

        allow delete: if isHost(code)
          || (
            signedIn()
            && request.auth.uid == playerUid
          );
      }

      match /private/{playerUid} {
        allow read: if signedIn()
          && (
            request.auth.uid == playerUid
            || isHost(code)
          );

        allow write: if isHost(code);
      }

      match /mafiaIntents/{playerUid} {
        allow read: if isHost(code) || (
          signedIn()
          && exists(/databases/$(database)/documents/rooms/$(code)/private/$(request.auth.uid))
          && get(/databases/$(database)/documents/rooms/$(code)/private/$(request.auth.uid)).data.role in ['Mafia', 'Silencer']
          && exists(/databases/$(database)/documents/rooms/$(code)/private/$(playerUid))
          && get(/databases/$(database)/documents/rooms/$(code)/private/$(playerUid)).data.role in ['Mafia', 'Silencer']
        );
        allow create, update: if signedIn()
          && request.auth.uid == playerUid
          && isMember(code)
          && request.resource.data.uid == playerUid
          && request.resource.data.role in ['Mafia', 'Silencer']
          && request.resource.data.keys().hasOnly(['uid', 'role', 'targetUid', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(code)/private/$(playerUid)).data.role == request.resource.data.role
          && get(roomPath(code)).data.phase == 'night';
        allow delete: if isHost(code) || (signedIn() && request.auth.uid == playerUid);
      }

      match /actions/{playerUid} {
        allow read: if signedIn()
          && (
            request.auth.uid == playerUid
            || isHost(code)
          );

        allow create: if signedIn()
          && request.auth.uid == playerUid
          && isMember(code)
          && validAction(code, playerUid);

        allow update: if false;

        allow delete: if isHost(code);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
