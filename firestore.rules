rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomPath(code) {
      return /databases/$(database)/documents/rooms/$(code);
    }

    function isMember(code) {
      return signedIn()
        && exists(roomPath(code))
        && request.auth.uid in get(roomPath(code)).data.memberUids;
    }

    function isHost(code) {
      return signedIn()
        && exists(roomPath(code))
        && get(roomPath(code)).data.hostUid == request.auth.uid;
    }

    function hostLeaseExpired(code) {
      let data = get(roomPath(code)).data;
      return (
        'hostHeartbeatAt' in data
        && data.hostHeartbeatAt is timestamp
        && data.hostHeartbeatAt < request.time - duration.value(30, 's')
      ) || (
        !('hostHeartbeatAt' in data)
        && 'createdAt' in data
        && data.createdAt < request.time - duration.value(30, 's')
      );
    }

    function canClaimHost(code) {
      return signedIn()
        && request.auth.uid in resource.data.memberUids
        && hostLeaseExpired(code)
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostHeartbeatAt == request.time
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['hostUid', 'hostHeartbeatAt', 'updatedAt']);
    }

    function validAction(code, playerUid) {
      let roomData = get(roomPath(code)).data;
      let actorPath = /databases/$(database)/documents/rooms/$(code)/players/$(playerUid);
      let targetPath = /databases/$(database)/documents/rooms/$(code)/players/$(request.resource.data.targetUid);
      let actorPrivatePath = /databases/$(database)/documents/rooms/$(code)/private/$(playerUid);
      let targetPrivatePath = /databases/$(database)/documents/rooms/$(code)/private/$(request.resource.data.targetUid);

      return request.resource.data.keys().hasOnly([
          'uid', 'type', 'targetUid', 'phase', 'round', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'type', 'targetUid', 'phase', 'round', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != playerUid
        && request.resource.data.phase == roomData.phase
        && request.resource.data.round == roomData.round
        && request.resource.data.updatedAt == request.time
        && exists(actorPath)
        && get(actorPath).data.alive == true
        && exists(targetPath)
        && get(targetPath).data.alive == true
        && (
          (
            request.resource.data.phase == 'night'
            && exists(actorPrivatePath)
            && exists(targetPrivatePath)
            && (
              (
                request.resource.data.type == 'kill'
                && get(actorPrivatePath).data.role == 'Mafia'
                && get(targetPrivatePath).data.role != 'Mafia'
              )
              || (
                request.resource.data.type == 'protect'
                && get(actorPrivatePath).data.role == 'Doctor'
              )
              || (
                request.resource.data.type == 'investigate'
                && get(actorPrivatePath).data.role == 'Detective'
              )
            )
          )
          || (
            request.resource.data.phase == 'voting'
            && request.resource.data.type == 'vote'
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'avatarData', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'avatarData', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 18
        && request.resource.data.avatarData is string
        && request.resource.data.avatarData.size() <= 150000
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'avatarData', 'gamesPlayed', 'wins', 'losses',
          'winRate', 'roleGames', 'roleWins', 'alignmentGames', 'alignmentWins',
          'mostPlayedRole', 'mostPlayedAlignment', 'currentWinStreak',
          'bestWinStreak', 'updatedAt'
        ]);
      allow delete: if false;

      match /games/{gameId} {
        allow read, create: if signedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    match /rooms/{code} {
      allow read: if isMember(code);

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.phase == 'lobby';

      allow update: if
        isHost(code)
        || canClaimHost(code)
        || (
          signedIn()
          && resource.data.phase == 'lobby'
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size()
            == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 12
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['memberUids', 'updatedAt'])
        )
        || (
          signedIn()
          && request.auth.uid in resource.data.memberUids
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.memberUids.size()
            == resource.data.memberUids.size() - 1
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['memberUids', 'hostUid', 'updatedAt'])
        );

      allow delete: if false;

      match /players/{playerUid} {
        allow read: if isMember(code);

        allow create: if isHost(code)
          || (
            signedIn()
            && request.auth.uid == playerUid
            && request.auth.uid in getAfter(roomPath(code)).data.memberUids
          );

        allow update: if isHost(code)
          || (
            signedIn()
            && request.auth.uid == playerUid
            && isMember(code)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['ready'])
            && request.resource.data.ready is bool
          );

        allow delete: if isHost(code)
          || (
            signedIn()
            && request.auth.uid == playerUid
          );
      }

      match /private/{playerUid} {
        allow read: if signedIn()
          && (
            request.auth.uid == playerUid
            || isHost(code)
          );

        allow write: if isHost(code);
      }

      match /actions/{playerUid} {
        allow read: if signedIn()
          && (
            request.auth.uid == playerUid
            || isHost(code)
          );

        allow create: if signedIn()
          && request.auth.uid == playerUid
          && isMember(code)
          && validAction(code, playerUid);

        allow update: if false;

        allow delete: if isHost(code);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
