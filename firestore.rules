rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'displayName',
          'avatarData',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'displayName',
          'avatarData',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 18
        && data.avatarData is string
        && data.avatarData.size() <= 150000
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validProfile(request.resource.data);

      allow delete: if false;
    }

    function isRoomMember(roomCode) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/rooms/$(roomCode)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/rooms/$(roomCode)
        ).data.memberUids;
    }

    match /rooms/{roomCode} {
      allow read: if isRoomMember(roomCode);
      allow write: if false;

      match /players/{playerUid} {
        allow read: if isRoomMember(roomCode);
        allow write: if false;
      }

      match /private/{document=**} {
        allow read, write: if false;
      }

      match /actions/{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
